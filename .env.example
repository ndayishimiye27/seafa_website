# Domaine confirmé ; laisser absent en développement.
# SITE_URL=https://domaine-confirme.example
SITE_INDEXABLE=false

# Chemin absolu privé sur un volume persistant, hors de public.
# Requis pour la livraison e-mail / WhatsApp et le mode local de développement.
# SEAFA_SYSTEM peut recevoir directement sans stockage local.
# SUBMISSIONS_DIR=/var/lib/seafa/submissions
# Sous Windows, configurer un dossier privé avec des ACL adaptées.

# À définir uniquement si votre proxy écrase cet en-tête.
# TRUSTED_IP_HEADER=x-real-ip

# À définir seulement après livraison et vérification de la page /login de SEAFA_SYSTEM.
# Son code actuel affiche encore une page provisoire. Aucun mot de passe n’est reçu ici.
# SEAFA_SYSTEM_LOGIN_URL=https://membres.domaine-confirme.example/login

# Livraison automatique optionnelle : aucun destinataire par défaut.
# Le système SEAFA reste prioritaire s’il est configuré.
# Sans système, l’e-mail complet est le mode de réception.
SEAFA_EMAIL_DELIVERY_ENABLED=false
SEAFA_TEAM_EMAIL=
SEAFA_EMAIL_FROM=
RESEND_API_KEY=

# Notification WhatsApp : type de formulaire et référence seulement.
# Nécessite un dossier accepté par SEAFA_SYSTEM ou par le service e-mail.
SEAFA_WHATSAPP_NOTIFICATIONS_ENABLED=false
SEAFA_TEAM_WHATSAPP=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=

# Un volume privé persistant est requis pour la file de livraison et les reprises.
# SUBMISSIONS_DIR=
