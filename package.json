{
  "name": "seafa-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "verify:routes": "node scripts/verify-routes.mjs",
    "format": "prettier --write src tests scripts docs README.md next.config.ts vercel.json playwright.config.ts package.json tsconfig.json eslint.config.mjs",
    "format:check": "prettier --check src tests scripts docs README.md next.config.ts vercel.json playwright.config.ts package.json tsconfig.json eslint.config.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "verify:content": "tsx src/lib/validate-content.ts",
    "deliveries:retry": "tsx scripts/retry-deliveries.ts",
    "verify:rendering": "node scripts/audit-rendering.mjs"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  }
}
